# GeneAI 后端环境变量示例
# 复制为 server/.env 后按需修改；启动时由 python-dotenv 自动加载，
# 但不会覆盖已经存在的真实环境变量。

# SQLite 文件位置（相对 server/ 目录或绝对路径）
GENEAI_DB_PATH=geneai.db

# 如需使用完整 SQLAlchemy URL，可覆盖上面的路径
# DATABASE_URL=sqlite:///./geneai.db

# 单条序列最大长度（bp）
MAX_SEQUENCE_LENGTH=100000

# 双序列比对时每条序列的最大长度（bp）
MAX_ALIGNMENT_LENGTH=5000

# FASTA 上传最大字节数（默认 2 MB）
MAX_UPLOAD_BYTES=2097152

# 开发期允许的跨域来源（正则）
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+
